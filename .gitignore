# runtime data and downloaded tools
/data/
/data-*/
/tools/
/bin/

# frontend
/frontend/node_modules/
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/

# embedded build output (copied from frontend/dist)
/backend/internal/web/dist/*
!/backend/internal/web/dist/.keep

# agent tooling
/.playwright-cli/
/.playwright-mcp/
/data-playwright/
# agent skills are local tooling, not part of the app
/.agents/
/skills-lock.json
# local agent/IDE configuration, may hold machine-specific settings or secrets
/.claude/
/.mcp.json
/agent/
/.kiro/
# root notes and scratch files, kept locally only
/AGENTS.md
/README.md
/dropbox.txt
/audio-init.mp4
